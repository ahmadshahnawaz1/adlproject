{"surah":114,"ayahs":[{"n":1,"arabic":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translit":"Qul aAAoothu birabbi alnnasi","t":{"eng-ummmuhammad":"Say, \"I seek refuge in the Lord of mankind"}},{"n":2,"arabic":"مَلِكِ ٱلنَّاسِ","translit":"Maliki alnnasi","t":{"eng-ummmuhammad":"The Sovereign of mankind"}},{"n":3,"arabic":"إِلَٰهِ ٱلنَّاسِ","translit":"Ilahi alnnasi","t":{"eng-ummmuhammad":"The God of mankind"}},{"n":4,"arabic":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","translit":"Min sharri alwaswasi alkhannasi","t":{"eng-ummmuhammad":"From the evil of the retreating whisperer"}},{"n":5,"arabic":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","translit":"Allathee yuwaswisu fee sudoori alnnasi","t":{"eng-ummmuhammad":"Who whispers [evil] into the breasts of mankind"}},{"n":6,"arabic":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","translit":"Mina aljinnati wa alnnasm","t":{"eng-ummmuhammad":"From among the jinn and mankind"}}]}