{"surah":112,"ayahs":[{"n":1,"arabic":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","translit":"Qul huwa Allahu ahadun","t":{"eng-ummmuhammad":"Say, \"He is Allah, [who is] One"}},{"n":2,"arabic":"ٱللَّهُ ٱلصَّمَدُ","translit":"Allahu alssamadu","t":{"eng-ummmuhammad":"Allah, the Eternal Refuge"}},{"n":3,"arabic":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","translit":"Lam yalid walam yooladu","t":{"eng-ummmuhammad":"He neither begets nor is born"}},{"n":4,"arabic":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","translit":"Walam yakun lahu kufuwan ahadun","t":{"eng-ummmuhammad":"Nor is there to Him any equivalent"}}]}