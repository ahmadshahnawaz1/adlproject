{"surah":82,"ayahs":[{"n":1,"words":[{"a":"إِذَا","t":"idhā","g":"When"},{"a":"ٱلسَّمَآءُ","t":"l-samāu","g":"the sky"},{"a":"ٱنفَطَرَتْ","t":"infaṭarat","g":"(is) cleft asunder"}]},{"n":2,"words":[{"a":"وَإِذَا","t":"wa-idhā","g":"And when"},{"a":"ٱلْكَوَاكِبُ","t":"l-kawākibu","g":"the stars"},{"a":"ٱنتَثَرَتْ","t":"intatharat","g":"scatter"}]},{"n":3,"words":[{"a":"وَإِذَا","t":"wa-idhā","g":"And when"},{"a":"ٱلْبِحَارُ","t":"l-biḥāru","g":"the seas"},{"a":"فُجِّرَتْ","t":"fujjirat","g":"are made to gush forth"}]},{"n":4,"words":[{"a":"وَإِذَا","t":"wa-idhā","g":"And when"},{"a":"ٱلْقُبُورُ","t":"l-qubūru","g":"the graves"},{"a":"بُعْثِرَتْ","t":"buʿ'thirat","g":"are overturned"}]},{"n":5,"words":[{"a":"عَلِمَتْ","t":"ʿalimat","g":"Will know"},{"a":"نَفْسٌۭ","t":"nafsun","g":"a soul"},{"a":"مَّا","t":"mā","g":"what"},{"a":"قَدَّمَتْ","t":"qaddamat","g":"it has sent forth"},{"a":"وَأَخَّرَتْ","t":"wa-akharat","g":"and left behind"}]},{"n":6,"words":[{"a":"يَـٰٓأَيُّهَا","t":"yāayyuhā","g":"O"},{"a":"ٱلْإِنسَـٰنُ","t":"l-insānu","g":"man"},{"a":"مَا","t":"mā","g":"What"},{"a":"غَرَّكَ","t":"gharraka","g":"has deceived you"},{"a":"بِرَبِّكَ","t":"birabbika","g":"concerning your Lord"},{"a":"ٱلْكَرِيمِ","t":"l-karīmi","g":"the Most Noble"}]},{"n":7,"words":[{"a":"ٱلَّذِى","t":"alladhī","g":"Who"},{"a":"خَلَقَكَ","t":"khalaqaka","g":"created you"},{"a":"فَسَوَّىٰكَ","t":"fasawwāka","g":"then fashioned you"},{"a":"فَعَدَلَكَ","t":"faʿadalaka","g":"then balanced you"}]},{"n":8,"words":[{"a":"فِىٓ","t":"fī","g":"In"},{"a":"أَىِّ","t":"ayyi","g":"whatever"},{"a":"صُورَةٍۢ","t":"ṣūratin","g":"form"},{"a":"مَّا","t":"mā","g":"what"},{"a":"شَآءَ","t":"shāa","g":"He willed"},{"a":"رَكَّبَكَ","t":"rakkabaka","g":"He assembled you"}]},{"n":9,"words":[{"a":"كَلَّا","t":"kallā","g":"Nay"},{"a":"بَلْ","t":"bal","g":"But"},{"a":"تُكَذِّبُونَ","t":"tukadhibūna","g":"you deny"},{"a":"بِٱلدِّينِ","t":"bil-dīni","g":"the Judgment"}]},{"n":10,"words":[{"a":"وَإِنَّ","t":"wa-inna","g":"