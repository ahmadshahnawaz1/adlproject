"},{"a":"ذَٰلِكَ","t":"dhālika","g":"that"},{"a":"لَـَٔايَـٰتٍۢ","t":"laāyātin","g":"surely (are) the signs"},{"a":"لِّكُلِّ","t":"likulli","g":"for everyone"},{"a":"صَبَّارٍۢ","t":"ṣabbārin","g":"patient"},{"a":"شَكُورٍۢ","t":"shakūrin","g":"and thankful"}]},{"n":6,"words":[{"a":"وَإِذْ","t":"wa-idh","g":"And when"},{"a":"قَالَ","t":"qāla","g":"said"},{"a":"مُوسَىٰ","t":"mūsā","g":"Musa"},{"a":"لِقَوْمِهِ","t":"liqawmihi","g":"to his people"},{"a":"ٱذْكُرُوا۟","t":"udh'kurū","g":"Remember"},{"a":"نِعْمَةَ","t":"niʿ'mata","g":"(the) Favor of Allah"},{"a":"ٱللَّهِ","t":"l-lahi","g":"(the) Favor of Allah"},{"a":"عَلَيْكُمْ","t":"ʿalaykum","g":"upon you"},{"a":"إِذْ","t":"idh","g":"when"},{"a":"أَنجَىٰكُم","t":"anjākum","g":"He saved you"},{"a":"مِّنْ","t":"min","g":"from"},{"a":"ءَالِ","t":"āli","g":"(the) people"},{"a":"فِرْعَوْنَ","t":"fir'ʿawna","g":"(of) Firaun"},{"a":"يَسُومُونَكُمْ","t":"yasūmūnakum","g":"they were afflicting you"},{"a":"سُوٓءَ","t":"sūa","g":"(with) evil"},{"a":"ٱلْعَذَابِ","t":"l-ʿadhābi","g":"torment"},{"a":"وَيُذَبِّحُونَ","t":"wayudhabbiḥūna","g":"and were slaughtering"},{"a":"أَبْنَآءَكُمْ","t":"abnāakum","g":"your sons"},{"a":"وَيَسْتَحْيُونَ","t":"wayastaḥyūna","g":"and letting live"},{"a":"نِسَآءَكُمْ ۚ","t":"nisāakum","g":"your women"},{"a":"وَفِى","t":"wafī","g":"And in"},{"a":"ذَٰلِكُم","t":"dhālikum","g":"that"},{"a":"بَلَآءٌۭ","t":"balāon","g":"(was) a trial"},{"a":"مِّن","t":"min","g":"from"},{"a":"رَّبِّكُمْ","t":"rabbikum","g":"your Lord"},{"a":"عَظِيمٌۭ","t":"ʿaẓīmun","g":"great"}]},{"n":7,"words":[{"a":"وَإِذْ","t":"wa-idh","g":"And when"},{"a":"تَأَذَّنَ","t":"ta-adhana","g":"proclaimed"},{"a":"رَبُّكُمْ","t":"rabbukum","g":"your Lord"},{"a":"لَئِن","t":"la-in","g":"If"},{"a":"شَكَرْتُمْ","t":"shakartum","g":"you are thankful"},{"a":"لَأَزِيدَنَّكُمْ ۖ","t":"la-azīdannakum","g":"surely I will increase you"},{"a":"وَلَئِن","t":"wala-in","g":"but if"},{"a":"كَفَرْتُمْ","t":"kafartum","g":"you are ungrateful"},{"a":"إِنَّ","t