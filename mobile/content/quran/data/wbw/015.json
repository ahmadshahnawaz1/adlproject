īna","g":"all"}]},{"n":44,"words":[{"a":"لَهَا","t":"lahā","g":"For it"},{"a":"سَبْعَةُ","t":"sabʿatu","g":"(are) seven"},{"a":"أَبْوَٰبٍۢ","t":"abwābin","g":"gates"},{"a":"لِّكُلِّ","t":"likulli","g":"for each"},{"a":"بَابٍۢ","t":"bābin","g":"gate"},{"a":"مِّنْهُمْ","t":"min'hum","g":"among them"},{"a":"جُزْءٌۭ","t":"juz'on","g":"(is) a portion"},{"a":"مَّقْسُومٌ","t":"maqsūmun","g":"assigned"}]},{"n":45,"words":[{"a":"إِنَّ","t":"inna","g":"Indeed"},{"a":"ٱلْمُتَّقِينَ","t":"l-mutaqīna","g":"the righteous"},{"a":"فِى","t":"fī","g":"(will be) in"},{"a":"جَنَّـٰتٍۢ","t":"jannātin","g":"Gardens"},{"a":"وَعُيُونٍ","t":"waʿuyūnin","g":"and water springs"}]},{"n":46,"words":[{"a":"ٱدْخُلُوهَا","t":"ud'khulūhā","g":"Enter it"},{"a":"بِسَلَـٰمٍ","t":"bisalāmin","g":"in peace"},{"a":"ءَامِنِينَ","t":"āminīna","g":"secure"}]},{"n":47,"words":[{"a":"وَنَزَعْنَا","t":"wanazaʿnā","g":"And We (will) remove"},{"a":"مَا","t":"mā","g":"what"},{"a":"فِى","t":"fī","g":"(is) in"},{"a":"صُدُورِهِم","t":"ṣudūrihim","g":"their breasts"},{"a":"مِّنْ","t":"min","g":"of"},{"a":"غِلٍّ","t":"ghillin","g":"rancor"},{"a":"إِخْوَٰنًا","t":"ikh'wānan","g":"(they will be) brothers"},{"a":"عَلَىٰ","t":"ʿalā","g":"on"},{"a":"سُرُرٍۢ","t":"sururin","g":"thrones"},{"a":"مُّتَقَـٰبِلِينَ","t":"mutaqābilīna","g":"facing each other"}]},{"n":48,"words":[{"a":"لَا","t":"lā","g":"Not"},{"a":"يَمَسُّهُمْ","t":"yamassuhum","g":"will touch them"},{"a":"فِيهَا","t":"fīhā","g":"therein"},{"a":"نَصَبٌۭ","t":"naṣabun","g":"fatigue"},{"a":"وَمَا","t":"wamā","g":"and not"},{"a":"هُم","t":"hum","g":"they"},{"a":"مِّنْهَا","t":"min'hā","g":"from it"},{"a":"بِمُخْرَجِينَ","t":"bimukh'rajīna","g":"will be removed"}]},{"n":49,"words":[{"a":"۞ نَبِّئْ","t":"nabbi","g":"Inform"},{"a":"عِبَادِىٓ","t":"ʿibādī","g":"My slaves"},{"a":"أَنِّىٓ","t":"annī","g":"that I"},{"a":"أَنَا","t":"anā","g":"I am"},{"a":"ٱلْغَفُورُ","t":"l-ghafūru","g":"the Oft-Forgiving"},{"a":"ٱلرَّحِيمُ","t":"l-raḥīmu","g":"the Most Merciful"}]},{"n":5