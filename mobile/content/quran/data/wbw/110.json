{"surah":110,"ayahs":[{"n":1,"words":[{"a":"إِذَا","t":"idhā","g":"When"},{"a":"جَآءَ","t":"jāa","g":"comes"},{"a":"نَصْرُ","t":"naṣru","g":"(the) Help"},{"a":"ٱللَّهِ","t":"l-lahi","g":"(of) Allah"},{"a":"وَٱلْفَتْحُ","t":"wal-fatḥu","g":"and the Victory"}]},{"n":2,"words":[{"a":"وَرَأَيْتَ","t":"wara-ayta","g":"And you see"},{"a":"ٱلنَّاسَ","t":"l-nāsa","g":"the people"},{"a":"يَدْخُلُونَ","t":"yadkhulūna","g":"entering"},{"a":"فِى","t":"fī","g":"into"},{"a":"دِينِ","t":"dīni","g":"(the) religion"},{"a":"ٱللَّهِ","t":"l-lahi","g":"(of) Allah"},{"a":"أَفْوَاجًۭا","t":"afwājan","g":"(in) multitudes"}]},{"n":3,"words":[{"a":"فَسَبِّحْ","t":"fasabbiḥ","g":"Then glorify"},{"a":"بِحَمْدِ","t":"biḥamdi","g":"with (the) praises"},{"a":"رَبِّكَ","t":"rabbika","g":"(of) your Lord"},{"a":"وَٱسْتَغْفِرْهُ ۚ","t":"wa-is'taghfir'hu","g":"and ask His forgiveness"},{"a":"إِنَّهُۥ","t":"innahu","g":"Indeed, He"},{"a":"كَانَ","t":"kāna","g":"is"},{"a":"تَوَّابًۢا","t":"tawwāban","g":"Oft-Returning"}]}]}