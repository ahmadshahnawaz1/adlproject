{"surah":93,"ayahs":[{"n":1,"words":[{"a":"وَٱلضُّحَىٰ","t":"wal-ḍuḥā","g":"By the morning brightness"}]},{"n":2,"words":[{"a":"وَٱلَّيْلِ","t":"wa-al-layli","g":"And the night"},{"a":"إِذَا","t":"idhā","g":"when"},{"a":"سَجَىٰ","t":"sajā","g":"it covers with darkness"}]},{"n":3,"words":[{"a":"مَا","t":"mā","g":"Not"},{"a":"وَدَّعَكَ","t":"waddaʿaka","g":"has forsaken you"},{"a":"رَبُّكَ","t":"rabbuka","g":"your Lord"},{"a":"وَمَا","t":"wamā","g":"and not"},{"a":"قَلَىٰ","t":"qalā","g":"He is displeased"}]},{"n":4,"words":[{"a":"وَلَلْـَٔاخِرَةُ","t":"walalākhiratu","g":"And surely the Hereafter"},{"a":"خَيْرٌۭ","t":"khayrun","g":"(is) better"},{"a":"لَّكَ","t":"laka","g":"for you"},{"a":"مِنَ","t":"mina","g":"than"},{"a":"ٱلْأُولَىٰ","t":"l-ūlā","g":"the first"}]},{"n":5,"words":[{"a":"وَلَسَوْفَ","t":"walasawfa","g":"And soon"},{"a":"يُعْطِيكَ","t":"yuʿ'ṭīka","g":"will give you"},{"a":"رَبُّكَ","t":"rabbuka","g":"your Lord"},{"a":"فَتَرْضَىٰٓ","t":"fatarḍā","g":"then you will be satisfied"}]},{"n":6,"words":[{"a":"أَلَمْ","t":"alam","g":"Did not"},{"a":"يَجِدْكَ","t":"yajid'ka","g":"He find you"},{"a":"يَتِيمًۭا","t":"yatīman","g":"an orphan"},{"a":"فَـَٔاوَىٰ","t":"faāwā","g":"and give shelter"}]},{"n":7,"words":[{"a":"وَوَجَدَكَ","t":"wawajadaka","g":"And He found you"},{"a":"ضَآلًّۭا","t":"ḍāllan","g":"lost"},{"a":"فَهَدَىٰ","t":"fahadā","g":"so He guided"}]},{"n":8,"words":[{"a":"وَوَجَدَكَ","t":"wawajadaka","g":"And He found you"},{"a":"عَآئِلًۭا","t":"ʿāilan","g":"in need"},{"a":"فَأَغْنَىٰ","t":"fa-aghnā","g":"so He made self-sufficient"}]},{"n":9,"words":[{"a":"فَأَمَّا","t":"fa-ammā","g":"So as for"},{"a":"ٱلْيَتِيمَ","t":"l-yatīma","g":"the orphan"},{"a":"فَلَا","t":"falā","g":"then (do) not"},{"a":"تَقْهَرْ","t":"taqhar","g":"oppress"}]},{"n":10,"words":[{"a":"وَأَمَّا","t":"wa-ammā","g":"And as for"},{"a":"ٱلسَّآئِلَ","t":"l-sāila","g":"one who asks"},{"a":"فَلَا","t":"falā","g":"then (do) not"},{"a":"تَنْهَرْ","t":"tanhar","g":"repel"}]},{"n":11,"w