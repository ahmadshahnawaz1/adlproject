{"surah":99,"ayahs":[{"n":1,"words":[{"a":"إِذَا","t":"idhā","g":"When"},{"a":"زُلْزِلَتِ","t":"zul'zilati","g":"is shaken"},{"a":"ٱلْأَرْضُ","t":"l-arḍu","g":"the earth"},{"a":"زِلْزَالَهَا","t":"zil'zālahā","g":"(with) its earthquake"}]},{"n":2,"words":[{"a":"وَأَخْرَجَتِ","t":"wa-akhrajati","g":"And brings forth"},{"a":"ٱلْأَرْضُ","t":"l-arḍu","g":"the earth"},{"a":"أَثْقَالَهَا","t":"athqālahā","g":"its burdens"}]},{"n":3,"words":[{"a":"وَقَالَ","t":"waqāla","g":"And says"},{"a":"ٱلْإِنسَـٰنُ","t":"l-insānu","g":"man"},{"a":"مَا","t":"mā","g":"What"},{"a":"لَهَا","t":"lahā","g":"(is) with it"}]},{"n":4,"words":[{"a":"يَوْمَئِذٍۢ","t":"yawma-idhin","g":"That Day"},{"a":"تُحَدِّثُ","t":"tuḥaddithu","g":"it will report"},{"a":"أَخْبَارَهَا","t":"akhbārahā","g":"its news"}]},{"n":5,"words":[{"a":"بِأَنَّ","t":"bi-anna","g":"Because"},{"a":"رَبَّكَ","t":"rabbaka","g":"your Lord"},{"a":"أَوْحَىٰ","t":"awḥā","g":"inspired"},{"a":"لَهَا","t":"lahā","g":"[to] it"}]},{"n":6,"words":[{"a":"يَوْمَئِذٍۢ","t":"yawma-idhin","g":"That Day"},{"a":"يَصْدُرُ","t":"yaṣduru","g":"will proceed"},{"a":"ٱلنَّاسُ","t":"l-nāsu","g":"the mankind"},{"a":"أَشْتَاتًۭا","t":"ashtātan","g":"(in) scattered groups"},{"a":"لِّيُرَوْا۟","t":"liyuraw","g":"to be shown"},{"a":"أَعْمَـٰلَهُمْ","t":"aʿmālahum","g":"their deeds"}]},{"n":7,"words":[{"a":"فَمَن","t":"faman","g":"So whoever"},{"a":"يَعْمَلْ","t":"yaʿmal","g":"does"},{"a":"مِثْقَالَ","t":"mith'qāla","g":"(equal to the) weight"},{"a":"ذَرَّةٍ","t":"dharratin","g":"(of) an atom"},{"a":"خَيْرًۭا","t":"khayran","g":"good"},{"a":"يَرَهُۥ","t":"yarahu","g":"will see it"}]},{"n":8,"words":[{"a":"وَمَن","t":"waman","g":"And whoever"},{"a":"يَعْمَلْ","t":"yaʿmal","g":"does"},{"a":"مِثْقَالَ","t":"mith'qāla","g":"(equal to the) weight"},{"a":"ذَرَّةٍۢ","t":"dharratin","g":"(of) an atom"},{"a":"شَرًّۭا","t":"sharran","g":"evil"},{"a":"يَرَهُۥ","t":"yarahu","g":"will see it"}]}]}