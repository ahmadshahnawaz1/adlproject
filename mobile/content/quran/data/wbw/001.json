{"surah":1,"ayahs":[{"n":1,"words":[{"a":"بِسْمِ","t":"bis'mi","g":"In (the) name"},{"a":"ٱللَّهِ","t":"l-lahi","g":"(of) Allah"},{"a":"ٱلرَّحْمَـٰنِ","t":"l-raḥmāni","g":"the Most Gracious"},{"a":"ٱلرَّحِيمِ","t":"l-raḥīmi","g":"the Most Merciful"}]},{"n":2,"words":[{"a":"ٱلْحَمْدُ","t":"al-ḥamdu","g":"All praises and thanks"},{"a":"لِلَّهِ","t":"lillahi","g":"(be) to Allah"},{"a":"رَبِّ","t":"rabbi","g":"the Lord"},{"a":"ٱلْعَـٰلَمِينَ","t":"l-ʿālamīna","g":"of the universe"}]},{"n":3,"words":[{"a":"ٱلرَّحْمَـٰنِ","t":"al-raḥmāni","g":"The Most Gracious"},{"a":"ٱلرَّحِيمِ","t":"l-raḥīmi","g":"the Most Merciful"}]},{"n":4,"words":[{"a":"مَـٰلِكِ","t":"māliki","g":"(The) Master"},{"a":"يَوْمِ","t":"yawmi","g":"(of the) Day"},{"a":"ٱلدِّينِ","t":"l-dīni","g":"(of the) Judgment"}]},{"n":5,"words":[{"a":"إِيَّاكَ","t":"iyyāka","g":"You Alone"},{"a":"نَعْبُدُ","t":"naʿbudu","g":"we worship"},{"a":"وَإِيَّاكَ","t":"wa-iyyāka","g":"and You Alone"},{"a":"نَسْتَعِينُ","t":"nastaʿīnu","g":"we ask for help"}]},{"n":6,"words":[{"a":"ٱهْدِنَا","t":"ih'dinā","g":"Guide us"},{"a":"ٱلصِّرَٰطَ","t":"l-ṣirāṭa","g":"(to) the path"},{"a":"ٱلْمُسْتَقِيمَ","t":"l-mus'taqīma","g":"the straight"}]},{"n":7,"words":[{"a":"صِرَٰطَ","t":"ṣirāṭa","g":"(The) path"},{"a":"ٱلَّذِينَ","t":"alladhīna","g":"(of) those"},{"a":"أَنْعَمْتَ","t":"anʿamta","g":"You have bestowed (Your) Favors"},{"a":"عَلَيْهِمْ","t":"ʿalayhim","g":"on them"},{"a":"غَيْرِ","t":"ghayri","g":"not (of)"},{"a":"ٱلْمَغْضُوبِ","t":"l-maghḍūbi","g":"those who earned (Your) wrath"},{"a":"عَلَيْهِمْ","t":"ʿalayhim","g":"on themselves"},{"a":"وَلَا","t":"walā","g":"and not"},{"a":"ٱلضَّآلِّينَ","t":"l-ḍālīna","g":"(of) those who go astray"}]}]}