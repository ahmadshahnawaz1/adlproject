{"surah":111,"ayahs":[{"n":1,"words":[{"a":"تَبَّتْ","t":"tabbat","g":"Perish"},{"a":"يَدَآ","t":"yadā","g":"(the) hands"},{"a":"أَبِى","t":"abī","g":"(of) Abu"},{"a":"لَهَبٍۢ","t":"lahabin","g":"Lahab"},{"a":"وَتَبَّ","t":"watabba","g":"and perish he"}]},{"n":2,"words":[{"a":"مَآ","t":"mā","g":"Not"},{"a":"أَغْنَىٰ","t":"aghnā","g":"(will) avail"},{"a":"عَنْهُ","t":"ʿanhu","g":"him"},{"a":"مَالُهُۥ","t":"māluhu","g":"his wealth"},{"a":"وَمَا","t":"wamā","g":"and what"},{"a":"كَسَبَ","t":"kasaba","g":"he earned"}]},{"n":3,"words":[{"a":"سَيَصْلَىٰ","t":"sayaṣlā","g":"He will be burnt"},{"a":"نَارًۭا","t":"nāran","g":"(in) a Fire"},{"a":"ذَاتَ","t":"dhāta","g":"of"},{"a":"لَهَبٍۢ","t":"lahabin","g":"Blazing Flames"}]},{"n":4,"words":[{"a":"وَٱمْرَأَتُهُۥ","t":"wa-im'ra-atuhu","g":"And his wife"},{"a":"حَمَّالَةَ","t":"ḥammālata","g":"(the) carrier"},{"a":"ٱلْحَطَبِ","t":"l-ḥaṭabi","g":"(of) firewood"}]},{"n":5,"words":[{"a":"فِى","t":"fī","g":"In"},{"a":"جِيدِهَا","t":"jīdihā","g":"her neck"},{"a":"حَبْلٌۭ","t":"ḥablun","g":"(will be) a rope"},{"a":"مِّن","t":"min","g":"of"},{"a":"مَّسَدٍۭ","t":"masadin","g":"palm-fiber"}]}]}