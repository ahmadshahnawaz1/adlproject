{"surah":91,"ayahs":[{"n":1,"words":[{"a":"وَٱلشَّمْسِ","t":"wal-shamsi","g":"By the sun"},{"a":"وَضُحَىٰهَا","t":"waḍuḥāhā","g":"and its brightness"}]},{"n":2,"words":[{"a":"وَٱلْقَمَرِ","t":"wal-qamari","g":"And the moon"},{"a":"إِذَا","t":"idhā","g":"when"},{"a":"تَلَىٰهَا","t":"talāhā","g":"it follows it"}]},{"n":3,"words":[{"a":"وَٱلنَّهَارِ","t":"wal-nahāri","g":"And the day"},{"a":"إِذَا","t":"idhā","g":"when"},{"a":"جَلَّىٰهَا","t":"jallāhā","g":"it displays it"}]},{"n":4,"words":[{"a":"وَٱلَّيْلِ","t":"wa-al-layli","g":"And the night"},{"a":"إِذَا","t":"idhā","g":"when"},{"a":"يَغْشَىٰهَا","t":"yaghshāhā","g":"it covers it"}]},{"n":5,"words":[{"a":"وَٱلسَّمَآءِ","t":"wal-samāi","g":"And the heaven"},{"a":"وَمَا","t":"wamā","g":"and (He) Who"},{"a":"بَنَىٰهَا","t":"banāhā","g":"constructed it"}]},{"n":6,"words":[{"a":"وَٱلْأَرْضِ","t":"wal-arḍi","g":"And the earth"},{"a":"وَمَا","t":"wamā","g":"and by (He) Who"},{"a":"طَحَىٰهَا","t":"ṭaḥāhā","g":"spread it"}]},{"n":7,"words":[{"a":"وَنَفْسٍۢ","t":"wanafsin","g":"And (the) soul"},{"a":"وَمَا","t":"wamā","g":"and (He) Who"},{"a":"سَوَّىٰهَا","t":"sawwāhā","g":"proportioned it"}]},{"n":8,"words":[{"a":"فَأَلْهَمَهَا","t":"fa-alhamahā","g":"And He inspired it"},{"a":"فُجُورَهَا","t":"fujūrahā","g":"(to distinguish) its wickedness"},{"a":"وَتَقْوَىٰهَا","t":"wataqwāhā","g":"and its righteousness"}]},{"n":9,"words":[{"a":"قَدْ","t":"qad","g":"Indeed"},{"a":"أَفْلَحَ","t":"aflaḥa","g":"he succeeds"},{"a":"مَن","t":"man","g":"who"},{"a":"زَكَّىٰهَا","t":"zakkāhā","g":"purifies it"}]},{"n":10,"words":[{"a":"وَقَدْ","t":"waqad","g":"And indeed"},{"a":"خَابَ","t":"khāba","g":"he fails"},{"a":"مَن","t":"man","g":"who"},{"a":"دَسَّىٰهَا","t":"dassāhā","g":"buries it"}]},{"n":11,"words":[{"a":"كَذَّبَتْ","t":"kadhabat","g":"Denied"},{"a":"ثَمُودُ","t":"thamūdu","g":"Thamud"},{"a":"بِطَغْوَىٰهَآ","t":"biṭaghwāhā","g":"by their transgression"}]},{"n":12,"words":[{"a":"إِذِ","t":"idhi","g":"When"},{"a":"ٱنۢبَعَثَ","t":"inbaʿatha","g":"(was) sent forth"},{"a":"أَشْقَىٰهَا","t":"ashqāhā","g":"(the) most wicked of them"}]},{"n":13,"words":[{"a":"فَقَالَ","t":"faqāla","g":"But said"},{"a":"لَهُمْ","t":"lahum","g":"to them"},{"a":"رَسُولُ","t":"rasūlu","g":"(the) Messenger"},{"a":"ٱللَّهِ","t":"l-lahi","g":"(of) Allah"},{"a":"نَاقَةَ","t":"nāqata","g":"(It is the) she-camel"},{"a":"ٱللَّهِ","t":"l-lahi","g":"(of) Allah"},{"a":"وَسُقْيَـٰهَا","t":"wasuq'yāhā","g":"and her drink"}]},{"n":14,"words":[{"a":"فَكَذَّبُوهُ","t":"fakadhabūhu","g":"But they denied him"},{"a":"فَعَقَرُوهَا","t":"faʿaqarūhā","g":"and they hamstrung her"},{"a":"فَدَمْدَمَ","t":"fadamdama","g":"So destroyed"},{"a":"عَلَيْهِمْ","t":"ʿalayhim","g":"them"},{"a":"رَبُّهُم","t":"rabbuhum","g":"their Lord"},{"a":"بِذَنۢبِهِمْ","t":"bidhanbihim","g":"for their sin"},{"a":"فَسَوَّىٰهَا","t":"fasawwāhā","g":"and leveled them"}]},{"n":15,"words":[{"a":"وَلَا","t":"walā","g":"And not"},{"a":"يَخَافُ","t":"yakhāfu","g":"He fears"},{"a":"عُقْبَـٰهَا","t":"ʿuq'bāhā","g":"its consequences"}]}]}