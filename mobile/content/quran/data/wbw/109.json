{"surah":109,"ayahs":[{"n":1,"words":[{"a":"قُلْ","t":"qul","g":"Say"},{"a":"يَـٰٓأَيُّهَا","t":"yāayyuhā","g":"O"},{"a":"ٱلْكَـٰفِرُونَ","t":"l-kāfirūna","g":"disbelievers"}]},{"n":2,"words":[{"a":"لَآ","t":"lā","g":"Not"},{"a":"أَعْبُدُ","t":"aʿbudu","g":"I worship"},{"a":"مَا","t":"mā","g":"what"},{"a":"تَعْبُدُونَ","t":"taʿbudūna","g":"you worship"}]},{"n":3,"words":[{"a":"وَلَآ","t":"walā","g":"And not"},{"a":"أَنتُمْ","t":"antum","g":"you"},{"a":"عَـٰبِدُونَ","t":"ʿābidūna","g":"(are) worshippers"},{"a":"مَآ","t":"mā","g":"(of) what"},{"a":"أَعْبُدُ","t":"aʿbudu","g":"I worship"}]},{"n":4,"words":[{"a":"وَلَآ","t":"walā","g":"And not"},{"a":"أَنَا۠","t":"anā","g":"I am"},{"a":"عَابِدٌۭ","t":"ʿābidun","g":"a worshipper"},{"a":"مَّا","t":"mā","g":"(of) what"},{"a":"عَبَدتُّمْ","t":"ʿabadttum","g":"you worship"}]},{"n":5,"words":[{"a":"وَلَآ","t":"walā","g":"And not"},{"a":"أَنتُمْ","t":"antum","g":"you"},{"a":"عَـٰبِدُونَ","t":"ʿābidūna","g":"(are) worshippers"},{"a":"مَآ","t":"mā","g":"(of) what"},{"a":"أَعْبُدُ","t":"aʿbudu","g":"I worship"}]},{"n":6,"words":[{"a":"لَكُمْ","t":"lakum","g":"For you"},{"a":"دِينُكُمْ","t":"dīnukum","g":"(is) your religion"},{"a":"وَلِىَ","t":"waliya","g":"and for me"},{"a":"دِينِ","t":"dīni","g":"(is) my religion"}]}]}