{"surah":106,"ayahs":[{"n":1,"words":[{"a":"لِإِيلَـٰفِ","t":"liīlāfi","g":"For (the) familiarity"},{"a":"قُرَيْشٍ","t":"qurayshin","g":"(of the) Quraish"}]},{"n":2,"words":[{"a":"إِۦلَـٰفِهِمْ","t":"īlāfihim","g":"Their familiarity"},{"a":"رِحْلَةَ","t":"riḥ'lata","g":"(with the) journey"},{"a":"ٱلشِّتَآءِ","t":"l-shitāi","g":"(of) winter"},{"a":"وَٱلصَّيْفِ","t":"wal-ṣayfi","g":"and summer"}]},{"n":3,"words":[{"a":"فَلْيَعْبُدُوا۟","t":"falyaʿbudū","g":"So let them worship"},{"a":"رَبَّ","t":"rabba","g":"(the) Lord"},{"a":"هَـٰذَا","t":"hādhā","g":"(of) this"},{"a":"ٱلْبَيْتِ","t":"l-bayti","g":"House"}]},{"n":4,"words":[{"a":"ٱلَّذِىٓ","t":"alladhī","g":"The One Who"},{"a":"أَطْعَمَهُم","t":"aṭʿamahum","g":"feeds them"},{"a":"مِّن","t":"min","g":"[from]"},{"a":"جُوعٍۢ","t":"jūʿin","g":"(against) hunger"},{"a":"وَءَامَنَهُم","t":"waāmanahum","g":"and gives them security"},{"a":"مِّنْ","t":"min","g":"from"},{"a":"خَوْفٍۭ","t":"khawfin","g":"fear"}]}]}