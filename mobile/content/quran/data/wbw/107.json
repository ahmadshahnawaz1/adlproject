{"surah":107,"ayahs":[{"n":1,"words":[{"a":"أَرَءَيْتَ","t":"ara-ayta","g":"Have you seen"},{"a":"ٱلَّذِى","t":"alladhī","g":"the one who"},{"a":"يُكَذِّبُ","t":"yukadhibu","g":"denies"},{"a":"بِٱلدِّينِ","t":"bil-dīni","g":"the Judgment"}]},{"n":2,"words":[{"a":"فَذَٰلِكَ","t":"fadhālika","g":"Then that"},{"a":"ٱلَّذِى","t":"alladhī","g":"(is) the one who"},{"a":"يَدُعُّ","t":"yaduʿʿu","g":"repulses"},{"a":"ٱلْيَتِيمَ","t":"l-yatīma","g":"the orphan"}]},{"n":3,"words":[{"a":"وَلَا","t":"walā","g":"And (does) not"},{"a":"يَحُضُّ","t":"yaḥuḍḍu","g":"feel the urge"},{"a":"عَلَىٰ","t":"ʿalā","g":"to"},{"a":"طَعَامِ","t":"ṭaʿāmi","g":"feed"},{"a":"ٱلْمِسْكِينِ","t":"l-mis'kīni","g":"the poor"}]},{"n":4,"words":[{"a":"فَوَيْلٌۭ","t":"fawaylun","g":"So woe"},{"a":"لِّلْمُصَلِّينَ","t":"lil'muṣallīna","g":"to those who pray"}]},{"n":5,"words":[{"a":"ٱلَّذِينَ","t":"alladhīna","g":"Those who"},{"a":"هُمْ","t":"hum","g":"[they]"},{"a":"عَن","t":"ʿan","g":"about"},{"a":"صَلَاتِهِمْ","t":"ṣalātihim","g":"their prayers"},{"a":"سَاهُونَ","t":"sāhūna","g":"(are) neglectful"}]},{"n":6,"words":[{"a":"ٱلَّذِينَ","t":"alladhīna","g":"Those who"},{"a":"هُمْ","t":"hum","g":"[they]"},{"a":"يُرَآءُونَ","t":"yurāūna","g":"make show"}]},{"n":7,"words":[{"a":"وَيَمْنَعُونَ","t":"wayamnaʿūna","g":"And they deny"},{"a":"ٱلْمَاعُونَ","t":"l-māʿūna","g":"[the] small kindnesses"}]}]}