{"surah":94,"ayahs":[{"n":1,"words":[{"a":"أَلَمْ","t":"alam","g":"Have not"},{"a":"نَشْرَحْ","t":"nashraḥ","g":"We expanded"},{"a":"لَكَ","t":"laka","g":"for you"},{"a":"صَدْرَكَ","t":"ṣadraka","g":"your breast"}]},{"n":2,"words":[{"a":"وَوَضَعْنَا","t":"wawaḍaʿnā","g":"And We removed"},{"a":"عَنكَ","t":"ʿanka","g":"from you"},{"a":"وِزْرَكَ","t":"wiz'raka","g":"your burden"}]},{"n":3,"words":[{"a":"ٱلَّذِىٓ","t":"alladhī","g":"Which"},{"a":"أَنقَضَ","t":"anqaḍa","g":"weighed upon"},{"a":"ظَهْرَكَ","t":"ẓahraka","g":"your back"}]},{"n":4,"words":[{"a":"وَرَفَعْنَا","t":"warafaʿnā","g":"And We raised high"},{"a":"لَكَ","t":"laka","g":"for you"},{"a":"ذِكْرَكَ","t":"dhik'raka","g":"your reputation"}]},{"n":5,"words":[{"a":"فَإِنَّ","t":"fa-inna","g":"So indeed"},{"a":"مَعَ","t":"maʿa","g":"with"},{"a":"ٱلْعُسْرِ","t":"l-ʿus'ri","g":"the hardship"},{"a":"يُسْرًا","t":"yus'ran","g":"(is) ease"}]},{"n":6,"words":[{"a":"إِنَّ","t":"inna","g":"Indeed"},{"a":"مَعَ","t":"maʿa","g":"with"},{"a":"ٱلْعُسْرِ","t":"l-ʿus'ri","g":"the hardship"},{"a":"يُسْرًۭا","t":"yus'ran","g":"(is) ease"}]},{"n":7,"words":[{"a":"فَإِذَا","t":"fa-idhā","g":"So when"},{"a":"فَرَغْتَ","t":"faraghta","g":"you have finished"},{"a":"فَٱنصَبْ","t":"fa-inṣab","g":"then labor hard"}]},{"n":8,"words":[{"a":"وَإِلَىٰ","t":"wa-ilā","g":"And to"},{"a":"رَبِّكَ","t":"rabbika","g":"your Lord"},{"a":"فَٱرْغَب","t":"fa-ir'ghab","g":"turn your attention"}]}]}