ىٓ","t":"fī","g":"within"},{"a":"أَنفُسِهِمْ","t":"anfusihim","g":"themselves"},{"a":"وَعَتَوْ","t":"waʿataw","g":"and (become) insolent"},{"a":"عُتُوًّۭا","t":"ʿutuwwan","g":"(with) insolence"},{"a":"كَبِيرًۭا","t":"kabīran","g":"great"}]},{"n":22,"words":[{"a":"يَوْمَ","t":"yawma","g":"(The) Day"},{"a":"يَرَوْنَ","t":"yarawna","g":"they see"},{"a":"ٱلْمَلَـٰٓئِكَةَ","t":"l-malāikata","g":"the Angels"},{"a":"لَا","t":"lā","g":"no"},{"a":"بُشْرَىٰ","t":"bush'rā","g":"glad tidings"},{"a":"يَوْمَئِذٍۢ","t":"yawma-idhin","g":"(will be) that Day"},{"a":"لِّلْمُجْرِمِينَ","t":"lil'muj'rimīna","g":"for the criminals"},{"a":"وَيَقُولُونَ","t":"wayaqūlūna","g":"and they will say"},{"a":"حِجْرًۭا","t":"ḥij'ran","g":"A partition"},{"a":"مَّحْجُورًۭا","t":"maḥjūran","g":"forbidden"}]},{"n":23,"words":[{"a":"وَقَدِمْنَآ","t":"waqadim'nā","g":"And We will proceed"},{"a":"إِلَىٰ","t":"ilā","g":"to"},{"a":"مَا","t":"mā","g":"whatever"},{"a":"عَمِلُوا۟","t":"ʿamilū","g":"they did"},{"a":"مِنْ","t":"min","g":"of"},{"a":"عَمَلٍۢ","t":"ʿamalin","g":"(the) deed(s)"},{"a":"فَجَعَلْنَـٰهُ","t":"fajaʿalnāhu","g":"and We will make them"},{"a":"هَبَآءًۭ","t":"habāan","g":"(as) dust"},{"a":"مَّنثُورًا","t":"manthūran","g":"dispersed"}]},{"n":24,"words":[{"a":"أَصْحَـٰبُ","t":"aṣḥābu","g":"(The) companions"},{"a":"ٱلْجَنَّةِ","t":"l-janati","g":"(of) Paradise"},{"a":"يَوْمَئِذٍ","t":"yawma-idhin","g":"that Day"},{"a":"خَيْرٌۭ","t":"khayrun","g":"(will be in) a better"},{"a":"مُّسْتَقَرًّۭا","t":"mus'taqarran","g":"abode"},{"a":"وَأَحْسَنُ","t":"wa-aḥsanu","g":"and a better"},{"a":"مَقِيلًۭا","t":"maqīlan","g":"resting-place"}]},{"n":25,"words":[{"a":"وَيَوْمَ","t":"wayawma","g":"And (the) Day"},{"a":"تَشَقَّقُ","t":"tashaqqaqu","g":"will split open"},{"a":"ٱلسَّمَآءُ","t":"l-samāu","g":"the heavens"},{"a":"بِٱلْغَمَـٰمِ","t":"bil-ghamāmi","g":"with the clouds"},{"a":"وَنُزِّلَ","t":"wanuzzila","g":"and (will be) sent down"},{"a":"ٱلْمَلَـٰٓئِكَةُ","t":"l-malāikatu","g":"the Angels"},{"a":"