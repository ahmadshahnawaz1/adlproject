{"surah":96,"ayahs":[{"n":1,"arabic":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","translit":"Iqra biismi rabbika allathee khalaqa","t":{"eng-ummmuhammad":"Recite in the name of your Lord who created"}},{"n":2,"arabic":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","translit":"Khalaqa alinsana min AAalaqin","t":{"eng-ummmuhammad":"Created man from a clinging substance"}},{"n":3,"arabic":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","translit":"Iqra warabbuka alakramu","t":{"eng-ummmuhammad":"Recite, and your Lord is the most Generous"}},{"n":4,"arabic":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","translit":"Allathee AAallama bialqalami","t":{"eng-ummmuhammad":"Who taught by the pen"}},{"n":5,"arabic":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","translit":"AAallama alinsana ma lam yaAAlam","t":{"eng-ummmuhammad":"Taught man that which he knew not"}},{"n":6,"arabic":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","translit":"Kalla inna alinsana layatgha","t":{"eng-ummmuhammad":"No! [But] indeed, man transgresses"}},{"n":7,"arabic":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","translit":"An raahu istaghna","t":{"eng-ummmuhammad":"Because he sees himself self-sufficient"}},{"n":8,"arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","translit":"Inna ila rabbika alrrujAAa","t":{"eng-ummmuhammad":"Indeed, to your Lord is the return"}},{"n":9,"arabic":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","translit":"Araayta allathee yanha","t":{"eng-ummmuhammad":"Have you seen the one who forbids"}},{"n":10,"arabic":"عَبۡدًا إِذَا صَلَّىٰٓ","translit":"AAabdan itha salla","t":{"eng-ummmuhammad":"A servant when he prays"}},{"n":11,"arabic":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","translit":"Araayta in kana AAala alhuda","t":{"eng-ummmuhammad":"Have you seen if he is upon guidance"}},{"n":12,"arabic":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","translit":"Aw amara bialttaqwa","t":{"eng-ummmuhammad":"Or enjoins righteousness"}},{"n":13,"arabic":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translit":"Araayta in kaththaba watawalla","t":{"eng-ummmuhammad":"Have you seen if he denies and turns away"}},{"n":14,"arabic":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translit":"Alam yaAAlam bianna Allaha yara","t":{"eng-ummmuhammad":"Does he not know that Allah sees"}},{"n":15,"arabic":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","translit":"Kalla lain lam yantahi lanasfaAAan bialnnasiyati","t":{"eng-ummmuhammad":"No! If he does not desist, We will surely drag him by the forelock"}},{"n":16,"arabic":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏","translit":"Nasiyatin kathibatin khatiatin","t":{"eng-ummmuhammad":"A lying, sinning forelock"}},{"n":17,"arabic":"فَلۡيَدۡعُ نَادِيَهُۥ","translit":"FalyadAAu nadiyahu","t":{"eng-ummmuhammad":"Then let him call his associates"}},{"n":18,"arabic":"سَنَدۡعُ ٱلزَّبَانِيَةَ","translit":"SanadAAu alzzabaniyata","t":{"eng-ummmuhammad":"We will call the angels of Hell"}},{"n":19,"arabic":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","translit":"Kalla la tutiAAhu waosjud waiqtarib","t":{"eng-ummmuhammad":"No! Do not obey him. But prostrate and draw near [to Allah]"}}]}