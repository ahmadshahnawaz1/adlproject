{"surah":107,"ayahs":[{"n":1,"arabic":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","translit":"Araayta allathee yukaththibu bialddeeni","t":{"eng-ummmuhammad":"Have you seen the one who denies the Recompense"}},{"n":2,"arabic":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","translit":"Fathalika allathee yaduAAAAu alyateema","t":{"eng-ummmuhammad":"For that is the one who drives away the orphan"}},{"n":3,"arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","translit":"Wala yahuddu AAala taAAami almiskeeni","t":{"eng-ummmuhammad":"And does not encourage the feeding of the poor"}},{"n":4,"arabic":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ","translit":"Fawaylun lilmusalleena","t":{"eng-ummmuhammad":"So woe to those who pray"}},{"n":5,"arabic":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","translit":"Allatheena hum AAan salatihim sahoona","t":{"eng-ummmuhammad":"[But] who are heedless of their prayer"}},{"n":6,"arabic":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","translit":"Allatheena hum yuraoona","t":{"eng-ummmuhammad":"Those who make show [of their deeds]"}},{"n":7,"arabic":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","translit":"WayamnaAAoona almaAAoona","t":{"eng-ummmuhammad":"And withhold [simple] assistance"}}]}