{"surah":109,"ayahs":[{"n":1,"arabic":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","translit":"Qul ya ayyuha alkafiroona","t":{"eng-ummmuhammad":"Say, \"O disbelievers"}},{"n":2,"arabic":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","translit":"La aAAbudu ma taAAbudoona","t":{"eng-ummmuhammad":"I do not worship what you worship"}},{"n":3,"arabic":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","translit":"Wala antum AAabidoona ma aAAbudu","t":{"eng-ummmuhammad":"Nor are you worshippers of what I worship"}},{"n":4,"arabic":"وَلَآ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ","translit":"Wala ana AAabidun ma AAabadtum","t":{"eng-ummmuhammad":"Nor will I be a worshipper of what you worship"}},{"n":5,"arabic":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","translit":"Wala antum AAabidoona ma aAAbudu","t":{"eng-ummmuhammad":"Nor will you be worshippers of what I worship"}},{"n":6,"arabic":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","translit":"Lakum deenukum waliya deeni","t":{"eng-ummmuhammad":"For you is your religion, and for me is my religion"}}]}